classDef userData stroke:#818cf8,fill:#eef2ff
classDef learningRepo stroke:#2dd4bf,fill:#f0fdfa
classDef document stroke:#a78bfa,fill:#f5f3ff
classDef system stroke:#fb923c,fill:#fff7ed

%% Assign color classes
class users,password_resets,notifications,system_feedbacks,semesters,combos,combo_subjects,subjects,badges,user_badges userData
class notebooks,chat_sessions,chat_messages,quizzes,quiz_questions,quiz_options,tests,user_quiz_progress,flashcard_decks,flashcards,user_flashcard_progress learningRepo
class documents,notebook_documents,document_chunks,tags,document_tags document
class content_reports,system_configs,market_reviews system