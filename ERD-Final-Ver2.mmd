    marketplace_clone_receipts {
        BIGSERIAL id PK
        BIGINT user_id FK "UQ(user_id, target_type, source_id); ON DELETE CASCADE"
        VARCHAR_30 target_type "UQ(user_id, target_type, source_id); CHECK 3 types"
        BIGINT source_id "UQ(user_id, target_type, source_id); logical reference"
