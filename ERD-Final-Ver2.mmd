%%{init: {"theme": "neutral", "er": {"useMaxWidth": false}}}%%
%% ============================================================================
%% AI STUDY HUB - ERD FINAL VER2
%% ============================================================================
%% Nguồn sự thật: 32 Flyway migrations V1 -> V32
%% Thư mục: backend/src/main/resources/db/migration
%% Trạng thái schema: sau khi áp dụng thành công V32
%% Tổng số: 45 bảng
%%
%% PHÂN NHÓM NGHIỆP VỤ
%%  1. Academic master data: semesters, combos, subjects, combo_subjects
%%  2. Users & auth: users, password_resets, registration_verifications
%%  3. System & audit: notifications, system_feedbacks, system_configs,
%%     activity_logs, ai_usage_logs
%%  4. Rewards & community roles: badges, user_badges, community_roles,
%%     reward_rules, reputation_events, ai_quota_tiers,
%%     community_role_nominations, referrals
%%  5. Learning workspace: notebooks, chat_sessions, chat_messages
%%  6. Documents & RAG: tags, documents, notebook_documents, document_chunks,
%%     document_tags, document_share_links, document_safety_reviews
%%  7. Quiz & tests: quizzes, quiz_questions, quiz_options, tests,
%%     user_quiz_progress, user_quiz_progress_selected_options
%%  8. Flashcards: flashcard_decks, flashcards, user_flashcard_progress
%%  9. Marketplace & governance: market_reviews, content_reports,
%%     community_comments, subject_review_policies, marketplace_submissions,
%%     marketplace_clone_receipts
%%
%% DẤU VẾT 32 MIGRATION
%%  V1  : tạo 30 bảng lõi và các FK/index ban đầu.
%%  V2  : chỉ seed dữ liệu; không đổi cấu trúc.
%%  V3-4: mở rộng document_chunks cho RAG và embedding.
%%  V5-6: admin note/status feedback; public system config.
%%  V7-8: AI practice trong chat_messages; bảo đảm cột is_public.
%%  V9-10: submit_note và self-FK cloned_from_id cho 3 loại tài nguyên.
%%  V11-13: ai_usage_logs; chuẩn hóa config/status dữ liệu.
%%  V14-17: share link, activity log, xử lý report, community comment.
%%  V18-19: policy/submission marketplace; analytics AI usage.
%%  V20-22: referral, soft-delete câu hỏi, chọn nhiều đáp án.
%%  V23-24: clone receipt cho document/quiz/flashcard deck.
%%  V25-26: reputation/reward/quota/nomination và giới hạn report.
%%  V27-28: xác minh email đăng ký và giới hạn theo IP.
%%  V29-30: moderation trạng thái tài liệu và safety review queue.
%%  V31-32: governance chat session; documents.file_url đổi sang TEXT.
%%
%% QUY ƯỚC
%%  PK = primary key; FK = foreign key vật lý; UK = unique key đơn.
%%  UQ(a,b) trong comment = unique key ghép; nullable = cột cho phép NULL.
%%  Các quan hệ bên dưới chỉ là FK vật lý trong PostgreSQL/Flyway.
%%
%% THAM CHIẾU ĐA HÌNH KHÔNG CÓ FK VẬT LÝ
%%  - activity_logs(target_type, target_id)
%%  - chat_messages(imported_target_type, imported_target_id)
%%  - community_roles(scope_type, scope_id)
%%  - marketplace_submissions(target_type, target_id)
%%  - marketplace_clone_receipts(target_type, source_id, cloned_resource_id)
%%  - reputation_events(target_type, target_id, source_type, source_id)
%%  Chúng có thể trỏ đến DOCUMENT / QUIZ / FLASHCARD_DECK hoặc đối tượng nghiệp
%%  vụ khác tùy cột type; không được hiểu nhầm là FK database.
%%
%% RÀNG BUỘC NGHIỆP VỤ QUAN TRỌNG
%%  - market_reviews: num_nonnulls(document_id, quiz_id, flashcard_deck_id) = 1
%%    (constraint NOT VALID duoc them tai V18).
%%  - content_reports: cung phai co dung mot trong ba target tren (NOT VALID).
%%  - marketplace_submissions: UQ(target_type, target_id, submission_round).
%%  - marketplace_clone_receipts: UQ(user_id, target_type, source_id), target_type
%%    chỉ nhận DOCUMENT, QUIZ, FLASHCARD_DECK.
%%  - referrals: mỗi owner_user_id có tối đa một dòng; status ACTIVE/APPLIED.
%%  - quiz_questions.deleted_at là soft-delete; selected_option_id cũ vẫn được giữ
%%    để tương thích, bảng selected_options hỗ trợ chọn nhiều đáp án từ V22.
%%  - documents.file_url có kiểu TEXT sau V32 (không còn VARCHAR(500)).
%% ============================================================================

erDiagram
    semesters {
        BIGSERIAL id PK
        VARCHAR_50 code UK
        VARCHAR_255 name
        TIMESTAMP created_at "default CURRENT_TIMESTAMP; nullable"
        TIMESTAMP updated_at "default CURRENT_TIMESTAMP; nullable"
    }

    combos {
        BIGSERIAL id PK
        VARCHAR_50 code UK
        VARCHAR_255 name
        TEXT description "nullable"
        TIMESTAMP created_at "default CURRENT_TIMESTAMP; nullable"
        TIMESTAMP updated_at "default CURRENT_TIMESTAMP; nullable"
    }

    subjects {
        BIGSERIAL id PK
        VARCHAR_50 code UK
        VARCHAR_255 name
        INT standard_semester_number "nullable"
        TIMESTAMP created_at "default CURRENT_TIMESTAMP; nullable"
        TIMESTAMP updated_at "default CURRENT_TIMESTAMP; nullable"
    }

    combo_subjects {
        BIGSERIAL id PK
        BIGINT combo_id FK "UQ(combo_id, subject_id); ON DELETE CASCADE"
        BIGINT subject_id FK "UQ(combo_id, subject_id); ON DELETE CASCADE"
    }

    users {
        BIGSERIAL id PK
        VARCHAR_255 google_id "nullable"
        VARCHAR_50 type "nullable"
        VARCHAR_255 email UK
        VARCHAR_255 password_hash "nullable"
        VARCHAR_255 full_name
        VARCHAR_500 avatar_url "nullable"
        BIGINT current_semester_id FK "nullable; ON DELETE SET NULL"
        BIGINT combo_id FK "nullable; ON DELETE SET NULL"
        VARCHAR_50 role "default STUDENT"
        INT reputation_points "default 0"
        BOOLEAN is_active "default TRUE"
        TIMESTAMP created_at "default CURRENT_TIMESTAMP; nullable"
        TIMESTAMP updated_at "default CURRENT_TIMESTAMP; nullable"
        BOOLEAN email_verified "default TRUE"
        VARCHAR_45 registration_ip "nullable"
    }

    password_resets {
        BIGSERIAL id PK
        BIGINT user_id FK "ON DELETE CASCADE"
        VARCHAR_255 reset_token UK
        TIMESTAMP expired_at
    }

    registration_verifications {
        BIGSERIAL id PK
        BIGINT user_id FK, UK "ON DELETE CASCADE"
